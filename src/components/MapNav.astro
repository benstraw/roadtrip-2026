---
import ShareButton from './ShareButton.astro';

interface Props {
  title: string;
  subtitle?: string;
  /** Optional id on the back link — mapbook uses this to rewrite href via JS */
  backId?: string;
}

const { title, subtitle, backId } = Astro.props;
---

<header class="map-nav">
  <h1 class="map-nav-title">{title}</h1>
  {subtitle && <span class="map-nav-subtitle">{subtitle}</span>}
  <ShareButton iconOnly />
  <a href="/" id={backId} class="map-nav-back">← Back to Trip</a>
</header>

<style>
  .map-nav {
    padding: 0.9rem 1.5rem;
    border-bottom: 1px solid var(--border, #1e2e40);
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .map-nav-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    color: var(--accent, #c8a84a);
    white-space: nowrap;
  }

  .map-nav-subtitle {
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted, #8a7e6a);
    white-space: nowrap;
  }

  .map-nav-back {
    margin-left: auto;
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted, #8a7e6a);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .map-nav-back:hover { color: var(--accent, #c8a84a); }

  @media (max-width: 480px) {
    .map-nav { padding: 0.75rem 0.8rem; gap: 0.65rem; }
    .map-nav-title { font-size: 0.95rem; }
    .map-nav-subtitle { display: none; }
    .map-nav-back { font-size: 0.56rem; }
  }
</style>
